# Copy to .env and fill in. Only APP_SECRET is required in production.

# Signs sessions and OAuth state, encrypts stored calendar tokens. 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out and disconnects Google Calendar.
APP_SECRET=

# Public address of this install, used in email links and the Google redirect.
APP_URL=http://localhost:3000

# Where the SQLite database lives. Back this directory up.
DATA_DIR=./data

# Optional: required on the /setup page, so nobody else can claim a fresh deployment.
SETUP_TOKEN=

# Number of reverse proxies in front of the app (nginx, Caddy, a load balancer).
# Used to find the real client IP for rate limiting. Must be accurate.
TRUST_PROXY_HOPS=1

# Which sites may embed /embed in an iframe. Space-separated origins, or * for any.
EMBED_ALLOWED_ORIGINS=*

# Email: console (default, logs only) | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Bookings <bookings@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Google Calendar sync (optional). See docs/GOOGLE_CALENDAR.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${APP_URL}/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# Optional platform credit, shown only when the business enables it in Settings.
POWERED_BY_TEXT=
POWERED_BY_URL=
